# Copie para .env.local e preencha. Nenhum valor daqui é secreto:
# tudo com prefixo NEXT_PUBLIC_ é embutido no bundle enviado ao navegador.

# URL do Stripe Payment Link. OBRIGATÓRIA — o build de produção falha sem ela.
# Atenção: teste e produção são links DIFERENTES (ver docs/stripe-config.md).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Analytics — opcionais. Sem o ID, o script não carrega e os eventos viram no-op.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp do suporte, só dígitos com DDI e DDD (ex: 5511999999999).
# Sem isso, os links de suporte caem para o e-mail de contato.
NEXT_PUBLIC_WHATSAPP_SUPORTE=
